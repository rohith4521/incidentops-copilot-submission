# IncidentOps Copilot - Environment Configuration
# Genuine Hindsight Cloud / Self-Hosted API Configuration
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=sre-incidentops-production
HINDSIGHT_TIMEOUT_SECONDS=30.0

# Groq Inference Configuration (Llama 3.3 70B / Qwen 2.5 32B)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
